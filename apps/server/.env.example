# QuietDash server (Phase 0)
QUIETDASH_PORT=3000
# Where the SQLite file is written (default: ./data under the server package)
# QUIETDASH_DATA_DIR=/data
QUIETDASH_INSTANCE_NAME=QuietDash
# single-password (self-host default) | multi-user (cloud)
AUTH_MODE=single-password
# Phase 0 only: fixed device token the dev panel uses to pull /api/device/image.
# Removed in Phase 1 once tokens are issued on pairing approval.
QUIETDASH_DEV_DEVICE_TOKEN=dev-device-token-phase0
