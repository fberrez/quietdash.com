{
  "name": "quietdash",
  "version": "0.0.0",
  "private": true,
  "description": "Calm e-ink ambient dashboard: self-hosted server + studio + device client",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:migrate": "pnpm --filter @quietdash/server db:migrate"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
