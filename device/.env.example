# QuietDash device client (Phase 1)
# Leave SERVER_URL empty to auto-discover the server via mDNS on the LAN.
# Set it to skip discovery (e.g. a cloud server, or a known IP).
QUIETDASH_SERVER_URL=
# Defaults to the hostname.
QUIETDASH_DEVICE_NAME=
QUIETDASH_REFRESH_SECONDS=300
# Where the issued token + server URL are persisted.
QUIETDASH_STATE_FILE=/var/lib/quietdash/state.json
# Used only by the file-save fallback (no panel attached).
QUIETDASH_OUT_FILE=/tmp/quietdash-latest.png
