[Unit]
Description=QuietDash e-ink device client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Installed by install.sh at these paths. Runs as root: WiFi provisioning drives
# nmcli/hostapd/iptables and binds :80. EnvironmentFile holds SERVER_URL + token.
WorkingDirectory=/opt/quietdash/device
EnvironmentFile=/opt/quietdash/device/.env
ExecStart=/usr/bin/python3 /opt/quietdash/device/quietdash_device.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
