# Reinstalled / rebuilt inside the image — never copy host artifacts in.
**/node_modules
**/dist
.git
.gitignore

# Local data, never ship a host DB into the image.
data
**/*.db
**/*.db-shm
**/*.db-wal

# Not part of the server image.
marketing
device/__pycache__
**/__pycache__
docs/screenshots

# Editor / OS noise.
.DS_Store
*.log
.env
**/.env
.claude
